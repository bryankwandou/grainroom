# The Rust toolchain leaves a few hundred megabytes of intermediate objects
# under anchor/target. None of it is needed to build the site, and left in
# place it pushes the upload past the point where it reliably completes.
anchor/target
anchor/.anchor
node_modules
.next
*.log

# The video project is its own npm workspace with its own dependencies, and
# none of it builds the site. Uploading part of it is worse than uploading
# none: the build then typechecks Remotion against modules that are not there.
video
